# Stage 1.5: ONE physical collector, ONE server.
#
# This file lists ONLY what must differ per deployment: secrets/credentials and
# instance-specific endpoints or digests. Every other knob (data paths, bucket
# names, size limits, rate limits, quotas, readiness timings, storage backend,
# legacy-key toggles) is hardcoded as a code default in
# src/climate_platform/config.py and, for Compose, in compose.yaml. Those values
# can still be overridden by an OS/compose environment variable when needed.

# --- Required secrets: set distinct, nonempty private values before starting. ---
COLLECTOR_API_KEY=
ADMIN_API_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Authentication policy ---
# Keep True for the static keys above. For Internet deployment set False and
# supply expiring hashed key records in API_KEYS instead; API startup rejects an
# empty list when static keys are disabled.
ENABLE_STATIC_KEYS=True
API_KEYS=[]

# --- Deployment profile and network binding ---
# deployment profile: development | testing | staging | production
ENVIRONMENT=development
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=False
# Local deployment anchor for relative data paths (docker image sets BASE_DIR=/storage).
# BASE_DIR=

# --- Object storage endpoint (instance specific) ---
# Native FastAPI/maintenance uses loopback; Compose always uses http://minio:9000.
S3_ENDPOINT=http://127.0.0.1:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Release gate: verified official image digests (see docs/security.md). ---
# Never use floating tags.
MINIO_DIGEST=
MINIO_MC_DIGEST=

# --- Optional image overrides for the single compose.yaml ---
# Explicit images do not bypass the official-image release verification gate.
# CLIMATE_API_IMAGE=climate-platform-api:latest
# API_PULL_POLICY=build
# MINIO_IMAGE=climate-minio-source:7aac2a2
# MINIO_MC_IMAGE=climate-mc-source:77f82e1
# MINIO_PULL_POLICY=never
# For an existing demo API image: API_PULL_POLICY=never and up --no-build.
