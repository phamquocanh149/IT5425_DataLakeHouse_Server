# Stage 1.5: ONE physical collector, ONE server.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=False
# deployment profile: development | testing | staging | production
ENVIRONMENT=development
# Local deployment anchor for relative data paths (docker image sets BASE_DIR=/storage).
# BASE_DIR=
# Legacy local data lake root (owns bronze/silver); relative to BASE_DIR or absolute.
# LOCAL_DATA_DIR=data_lake
DATA_LAKE_DIR=data_lake
METADATA_DIR=metadata
# Disposable scratch dir for processing temp files (relative to BASE_DIR or absolute).
# SCRATCH_DIR=data_lake/temp
TEMP_DIR=data_lake/temp
MAX_FILE_SIZE_BYTES=20971520
CHUNK_SIZE_BYTES=1048576
# Required: set distinct, nonempty private secrets before starting.
COLLECTOR_API_KEY=
ADMIN_API_KEY=
COLLECTOR_SOURCES=["usdm","noaa","usgs","nldas"]
# Migration only: disabled unless explicitly enabled. Historical IDs remain intact.
ENABLE_LEGACY_KEYS=False
CLIENT01_API_KEY=
CLIENT02_API_KEY=

# Supply verified official digests; see docs/security.md. Never use floating tags.
MINIO_DIGEST=
MINIO_MC_DIGEST=
# Single compose.yaml: optional explicit images for local source builds or demo.
# Explicit images do not bypass the official-image release verification gate.
# CLIMATE_API_IMAGE=climate-platform-api:latest
# API_PULL_POLICY=build
# MINIO_IMAGE=climate-minio-source:7aac2a2
# MINIO_MC_IMAGE=climate-mc-source:77f82e1
# MINIO_PULL_POLICY=never
# For an existing demo API image: API_PULL_POLICY=never and up --no-build.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BACKEND=s3
# Native FastAPI/maintenance uses loopback; Compose always uses http://minio:9000.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_BRONZE=climate-bronze
S3_BUCKET_SILVER=climate-silver
S3_BUCKET_GOLD=climate-gold
S3_BUCKET_WAREHOUSE=climate-warehouse
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Migration: set false after deploying expiring key-id.secret credentials to clients.
ENABLE_STATIC_KEYS=True
API_KEYS=[]
RATE_LIMIT_PER_MINUTE=120
DAILY_UPLOAD_QUOTA_BYTES=1073741824
READINESS_CACHE_SECONDS=3
READINESS_TIMEOUT_SECONDS=0.5
# Enable only after provisioning external KMS/default retention; startup verifies both.
REQUIRE_SSE_KMS=False
REQUIRE_OBJECT_LOCK=False

# Short bounded registry lock wait; schema migration only runs at startup.
SQLITE_BUSY_TIMEOUT_SECONDS=0.5
