# Stage 1.5: ONE physical collector, ONE server.
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=False
DATA_LAKE_DIR=data_lake
METADATA_DIR=metadata
TEMP_DIR=data_lake/temp
MAX_FILE_SIZE_BYTES=20971520
CHUNK_SIZE_BYTES=1048576
# Required: set distinct, nonempty private secrets before starting.
COLLECTOR_API_KEY=
ADMIN_API_KEY=
COLLECTOR_SOURCES=["usdm","noaa","usgs","nldas"]
# Migration only: disabled unless explicitly enabled. Historical IDs remain intact.
ENABLE_LEGACY_KEYS=False
CLIENT01_API_KEY=
CLIENT02_API_KEY=

# MinIO: verified linux/amd64 manifests; no emulation and no floating latest tag.
MINIO_IMAGE=noname12346767/my-minio@sha256:ff3fdcaaf08a067191989010ad2862da14e0238973f6586750d740adb6d589bc
MINIO_MC_IMAGE=noname12346767/mc-allos@sha256:18a6fc4d2af4807386cd0a76d1a7078144c8ad46a7eb6ed1bd6577b902a34c6d
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
STORAGE_BACKEND=s3
# Native FastAPI/maintenance uses loopback; Compose always uses http://minio:9000.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_BRONZE=climate-bronze
S3_BUCKET_SILVER=climate-silver
S3_BUCKET_GOLD=climate-gold
S3_BUCKET_WAREHOUSE=climate-warehouse
S3_ACCESS_KEY=
S3_SECRET_KEY=
