# Server Network Settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=False

# Storage & Ingestion Limits
DATA_LAKE_DIR=data_lake
METADATA_DIR=metadata
MAX_FILE_SIZE_BYTES=20971520 # 20MB limit in bytes
CHUNK_SIZE_BYTES=1048576      # 1MB chunk size for streaming uploads

# Client Authentication Keys (Do NOT commit real production keys)
# Client 01: USDM and NOAA data ingestion
CLIENT01_API_KEY=
# Client 02: NASA NLDAS-2 and USGS data ingestion
CLIENT02_API_KEY=
# Admin / Management Key
ADMIN_API_KEY=
