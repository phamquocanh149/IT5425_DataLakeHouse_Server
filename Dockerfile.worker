FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md requirements.txt requirements-gis.txt ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements.txt -r requirements-gis.txt \
    && pip install --no-cache-dir --no-deps . \
    && rm -rf /app/build /app/src/*.egg-info \
    && groupadd --gid 10001 climate \
    && useradd --uid 10001 --gid climate --no-create-home climate \
    && mkdir -p /storage && chown climate:climate /storage
COPY scripts ./scripts
USER 10001:10001
ENV BASE_DIR=/storage
CMD ["python", "scripts/usdm/run_usdm.py", "--help"]
