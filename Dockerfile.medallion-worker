FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md requirements.txt requirements-gis.txt requirements-nldas.txt requirements-dagster.txt ./
COPY src ./src
RUN pip install --no-cache-dir \
        -r requirements.txt -r requirements-gis.txt -r requirements-nldas.txt \
        -r requirements-dagster.txt \
    && pip install --no-cache-dir --no-deps . \
    && rm -rf /app/build /app/src/*.egg-info \
    && groupadd --gid 10001 climate \
    && useradd --uid 10001 --gid climate --no-create-home climate \
    && mkdir -p /storage/metadata /worker-cache /dagster-home \
    && chown -R climate:climate /storage /worker-cache /dagster-home
USER 10001:10001
ENV BASE_DIR=/storage DAGSTER_HOME=/dagster-home HOME=/dagster-home
CMD ["dagster", "code-server", "start", "-h", "0.0.0.0", "-p", "4000", "-f", "/app/src/climate_platform/orchestration/definitions.py"]
